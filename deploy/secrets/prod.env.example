# ─────────────────────────────────────────────────────────────────────────────
# Production secrets + environment — TEMPLATE (no real values; committed for reference).
#
# Copy to deploy/secrets/prod.env, fill in REAL values, then encrypt:
#   cp deploy/secrets/prod.env.example deploy/secrets/prod.env
#   # edit deploy/secrets/prod.env …
#   sops -e deploy/secrets/prod.env > deploy/secrets/prod.enc.env   # commit prod.enc.env only
# deploy/secrets/prod.env is gitignored — never commit the plaintext.
#
# This ONE file is the single source of truth for every secret AND every URL. CI reads only
# the VITE_* URLs from it (to bake the front bundles); the VM reads the whole file at runtime.
# ─────────────────────────────────────────────────────────────────────────────

# ── Domain & public URLs (drive fronts + CORS + redirects; not secret, kept here as one source)
DOMAIN=example.com
ACME_EMAIL=ops@example.com                     # Let's Encrypt contact for Caddy
VITE_AUTH_SERVICE_URL=https://auth.example.com
VITE_API_URL=https://api.example.com
VITE_APP_URL=https://app.example.com
VITE_ADMIN_URL=https://admin.example.com
CORS_ORIGINS=https://app.example.com,https://admin.example.com
AUTH_PUBLIC_URL=https://auth.example.com
CONTRACTS_SIGN_REDIRECT_URL=https://app.example.com/mes-contrats
TRUST_PROXY=1

# ── Core secrets
INTERNAL_SERVICE_TOKEN=REPLACE_with_32+_random_bytes    # api ↔ auth-service internal auth
MONGO_ROOT_USERNAME=REPLACE
MONGO_ROOT_PASSWORD=REPLACE
MONGODB_DB=db
NEO4J_PASSWORD=REPLACE
MONGO_EXPRESS_USERNAME=REPLACE                  # basic-auth for the Mongo admin UI
MONGO_EXPRESS_PASSWORD=REPLACE

# ── Object storage (MinIO; api reuses these for message/listing media)
DOCUMENSO_S3_ACCESS_KEY=REPLACE
DOCUMENSO_S3_SECRET_KEY=REPLACE
DOCUMENSO_S3_BUCKET=documenso
DOCUMENSO_S3_REGION=us-east-1

# ── Email (Resend; mail is a no-op if unset)
RESEND_API_KEY=REPLACE_or_leave_empty
FROM_EMAIL=no-reply@example.com
TOTP_ISSUER=Connected-Neighboors
APP_NAME=Connected-Neighboors

# ── Documenso (e-signature). Encryption keys/secrets required; API token/template set once in its UI.
DOCUMENSO_DB_USER=REPLACE
DOCUMENSO_DB_PASSWORD=REPLACE
DOCUMENSO_DB_NAME=documenso
DOCUMENSO_NEXTAUTH_SECRET=REPLACE
DOCUMENSO_ENCRYPTION_KEY=REPLACE
DOCUMENSO_ENCRYPTION_SECONDARY_KEY=REPLACE
DOCUMENSO_PUBLIC_URL=https://documenso.example.com
DOCUMENSO_API_TOKEN=                            # created once in the Documenso UI
DOCUMENSO_TEMPLATE_ID=
DOCUMENSO_WEBHOOK_SECRET=
DOCUMENSO_SIGNING_LANGUAGE=fr
DOCUMENSO_SIGNING_PASSPHRASE=

# ── Superadmin seed (auth-seed one-shot)
SEED_SUPERADMIN_EMAIL=admin@example.com
SEED_SUPERADMIN_PASSWORD=REPLACE
