# Production env template. Copy to secrets/prod.env, fill in real values, then
# encrypt with SOPS and commit the result:
#
#   cp secrets/prod.env.example secrets/prod.env
#   $EDITOR secrets/prod.env
#   sops -e secrets/prod.env > secrets/prod.enc.env   # commit prod.enc.env only
#
# secrets/prod.env itself is gitignored. docker-compose.prod.yml reads it via
# env_file; scripts/deploy.sh regenerates it from prod.enc.env on every deploy.

# ── Public domains (Caddy TLS + app URLs) ────────────────────────────────────
ACME_EMAIL=admin@example.com
USER_DOMAIN=app.example.com
ADMIN_DOMAIN=admin.example.com
API_DOMAIN=api.example.com
AUTH_DOMAIN=auth.example.com

# ── Mongo ────────────────────────────────────────────────────────────────────
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_strong_password
# Must embed the same user/password as above.
MONGODB_URL=mongodb://root:CHANGE_ME_strong_password@mongodb:27017
MONGODB_DB=db

# ── Neo4j ────────────────────────────────────────────────────────────────────
NEO4J_AUTH=neo4j/CHANGE_ME_strong_password

# ── auth-service ─────────────────────────────────────────────────────────────
PORT=3001
AUTH_PUBLIC_URL=https://auth.example.com
# Browser-facing origins allowed by CORS (both fronts). Shared by api + auth.
CORS_ORIGINS=https://app.example.com,https://admin.example.com
# RS256 keypair (PKCS8 private / SPKI public). Generate with the openssl snippet
# in TODO.md, then paste as a SINGLE line using \n for newlines, e.g.:
#   AUTH_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n
AUTH_PRIVATE_KEY=
AUTH_PUBLIC_KEY=
TOTP_ISSUER=Web-Apps
# Email (Resend). Leave RESEND_API_KEY blank to make mail a no-op.
RESEND_API_KEY=
FROM_EMAIL=no-reply@example.com
APP_NAME=Web-Apps

# ── Superadmin seed (npm run seed:superadmin -w auth-service) ─────────────────
SEED_SUPERADMIN_EMAIL=superadmin@example.com
SEED_SUPERADMIN_PASSWORD=CHANGE_ME_strong_password
SEED_SUPERADMIN_FIRSTNAME=Super
SEED_SUPERADMIN_LASTNAME=Admin
