# Reverse proxy Caddy pour la stack de production. DOMAIN et ACME_EMAIL sont lus depuis
# l'environnement du conteneur (fourni par l'env dechiffre par SOPS lors du job de deploiement).
# Caddy obtient et renouvelle automatiquement les certificats Let's Encrypt pour chaque bloc
# d'hote ci-dessous.
{
	email {$ACME_EMAIL}
}

# Site vitrine sur le domaine racine.
{$DOMAIN} {
	reverse_proxy landing:8080
}

# SPA des residents.
app.{$DOMAIN} {
	reverse_proxy user-front:8080
}

# Console d'administration.
admin.{$DOMAIN} {
	reverse_proxy admin-front:8080
}

# API de ressources.
api.{$DOMAIN} {
	reverse_proxy api:3000
}

# Service d'authentification (pages login/register, JWKS, endpoints de token).
auth.{$DOMAIN} {
	reverse_proxy auth-service:3001
}

# Signature electronique Documenso (liens de signature + webhook). Doit etre en HTTPS.
documenso.{$DOMAIN} {
	reverse_proxy documenso:3030
}
