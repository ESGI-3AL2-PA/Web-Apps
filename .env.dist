# Copy to .env and fill in. Values shown are the localhost defaults baked into
# the code — you only need to override what differs. Secrets are left blank.

# ── Ports ────────────────────────────────────────────────────────────────────
# Every port is env-driven with the default shown; override any that collide.
# In Docker these set the HOST side of the mapping (container-internal ports are
# fixed), so inter-service URLs below don't need to change when you remap.
API_PORT=3000
AUTH_PORT=3001
ADMIN_PORT=4000
LANDING_PORT=6060
USER_PORT=5000
MONGO_PORT=27017
MONGO_EXPRESS_PORT=8081
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ── Shared: Mongo (api + auth-service) ───────────────────────────────────────
# Root credentials the mongodb container is initialised with. In the prod compose
# these are required (no default) and also build MONGODB_URL / the mongo-express UI.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=root
MONGODB_URL=mongodb://root:root@localhost:27017
MONGODB_DB=db
# HTTP basic-auth credentials guarding the mongo-express admin UI (prod compose).
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=change-me

# ── Shared: Neo4j (api) — graph projection + recommendation engine ───────────
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ── apps/api (port 3000) ─────────────────────────────────────────────────────
NODE_ENV=development
# /openapi.json + /docs are served in dev; in production they're off unless set to "true".
# ENABLE_API_DOCS=true
# JWKS endpoint the api uses to verify access tokens
AUTH_JWKS_URL=http://localhost:3001/.well-known/jwks.json
# Base URL the api calls to purge auth-service sessions on account deletion (GDPR erasure)
AUTH_SERVICE_URL=http://localhost:3001
# Shared secret for internal api→auth-service calls (X-Internal-Token). Must match on
# both services. Generate a strong random value in prod; dev placeholder below.
INTERNAL_SERVICE_TOKEN=dev-internal-service-token
# Comma-separated allowed CORS origins (api default: fronts only)
CORS_ORIGINS=http://localhost:4000,http://localhost:5000
# Behind a reverse proxy/LB, set to the number of trusted hops (e.g. "1") so req.ip
# reflects the real client (drives rate-limiting + refresh-cookie security). Unset =
# don't trust X-Forwarded-For. Also read by auth-service.
# TRUST_PROXY=1
# Voice-message audio (.webm) is stored in self-hosted MinIO. Point these at the MinIO
# instance and a dedicated bucket (must be created — see the compose init job).
MESSAGES_MINIO_ENDPOINT=http://localhost:9000
MESSAGES_MINIO_BUCKET=messages
MESSAGES_MINIO_ACCESS_KEY=
MESSAGES_MINIO_SECRET_KEY=
# Listing images are stored in the same MinIO (dedicated bucket, auto-created on first
# use). Endpoint/creds fall back to MESSAGES_MINIO_* if left blank.
LISTINGS_MINIO_ENDPOINT=http://localhost:9000
LISTINGS_MINIO_BUCKET=listings
LISTINGS_MINIO_ACCESS_KEY=
LISTINGS_MINIO_SECRET_KEY=
# Public base URL the api uses to build listing-image URLs (defaults to the request host).
# API_PUBLIC_URL=http://localhost:3000

# Documenso e-signature (contracts). The api orchestrates document creation from a
# pre-configured template and reacts to Documenso webhooks. Local stack lives in
# docker-compose.yml; generate an API token + template in the Documenso UI.
DOCUMENSO_URL=http://localhost:3030
DOCUMENSO_API_TOKEN=
# Numeric v1 template id with two SIGNER placeholders (provider, then beneficiary).
DOCUMENSO_TEMPLATE_ID=
# Shared secret configured on the Documenso webhook; verifies inbound X-Documenso-Secret.
DOCUMENSO_WEBHOOK_SECRET=
# Signing UI language + where Documenso redirects the user after signing (optional).
DOCUMENSO_SIGNING_LANGUAGE=fr
CONTRACTS_SIGN_REDIRECT_URL=http://localhost:5000/mes-contrats
# SSRF allowlist (comma-separated host[:port]) for the signed-PDF download URL Documenso
# returns. The Documenso base URL host and the api's MinIO endpoint(s) are always allowed;
# set this only when Documenso presigns downloads against a different object-store host.
DOCUMENSO_DOWNLOAD_HOSTS=

# Local-only ports for the Documenso stack (docker-compose.yml).
DOCUMENSO_PORT=3030
DOCUMENSO_DB_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ── Production ingress (Caddy, docker-compose.deploy.yml) ────────────────────
# The deploy compose fronts every app with Caddy (automatic Let's Encrypt). DOMAIN
# is the apex (landing); the apps live on its subdomains — app./admin./api./auth./
# documenso. ACME_EMAIL is optional (Let's Encrypt expiry notices).
DOMAIN=example.com
ACME_EMAIL=

# ── Documenso — production self-host (docker-compose.deploy.yml) ─────────────
# The prod compose runs its own Documenso + Postgres + MinIO. These are required
# (compose errors if unset). SMTP reuses Resend (RESEND_API_KEY / FROM_EMAIL above).
DOCUMENSO_DB_USER=documenso
DOCUMENSO_DB_PASSWORD=
DOCUMENSO_DB_NAME=documenso
DOCUMENSO_S3_ACCESS_KEY=
DOCUMENSO_S3_SECRET_KEY=
DOCUMENSO_S3_REGION=
DOCUMENSO_S3_BUCKET=documenso
DOCUMENSO_NEXTAUTH_SECRET=
DOCUMENSO_ENCRYPTION_KEY=
DOCUMENSO_ENCRYPTION_SECONDARY_KEY=
# Public browser-facing URL of the Documenso instance (signing pages).
DOCUMENSO_PUBLIC_URL=
# Host path to the P12 signing certificate mounted into the container.
DOCUMENSO_CERT_PATH=./docker/documenso/cert.p12
DOCUMENSO_SIGNING_PASSPHRASE=

# ── apps/auth-service (port 3001) ────────────────────────────────────────────
# Where auth-service calls the api to create users on register
API_URL=http://localhost:3000
# Public base URL of auth-service, used to build email links
AUTH_PUBLIC_URL=http://localhost:3001
# auth-service default also allows the api origin:
# CORS_ORIGINS=http://localhost:3000,http://localhost:4000,http://localhost:5000

# RS256 PEM keypair for signing access tokens. Provide inline (AUTH_*_KEY) or via a
# mounted file (AUTH_*_KEY_FILE). If neither is set, an ephemeral keypair is generated
# on boot — but that rotates on every restart, so the dev compose mounts stable keys
# (scripts/gen-auth-keys.sh → docker/auth/) via AUTH_*_KEY_FILE. Required in prod.
AUTH_PRIVATE_KEY=
AUTH_PUBLIC_KEY=
# AUTH_PRIVATE_KEY_FILE=/run/auth-keys/private.pem
# AUTH_PUBLIC_KEY_FILE=/run/auth-keys/public.pem
# Key rotation. The kid stamped on signed tokens + published in the JWKS defaults to the
# key's RFC 7638 JWK thumbprint, i.e. it is derived from the key material itself. That is
# deliberate: consumers cache the JWKS *by kid*, so republishing different material under a
# reused kid makes every signature fail with no way for them to notice (jose only refetches
# on an *unknown* kid; the desktop client's cache has no TTL at all). A thumbprint kid makes
# that mistake impossible — new material always means a new kid, which is the self-healing path.
#
# So to rotate, just swap the keypair and publish the OLD public key as a verify-only entry via
# AUTH_PUBLIC_KEY_PREVIOUS (or _FILE); its kid is likewise derived. Both kids stay in the JWKS
# until in-flight tokens (15 min) drain, then drop the _PREVIOUS vars.
#
# AUTH_KEY_ID / AUTH_KEY_ID_PREVIOUS override the derived kids. Pinning is an escape hatch, not
# the norm — a pinned kid that doesn't match its key's thumbprint logs a warning on every boot,
# because it reintroduces exactly the failure above. Its one legitimate use is the one-time
# migration off the historical static "auth-1": publish the CURRENT key under both kids for one
# access-token lifetime so tokens minted before the switch keep verifying —
#   AUTH_PUBLIC_KEY_PREVIOUS=<same PEM as AUTH_PUBLIC_KEY>
#   AUTH_KEY_ID_PREVIOUS=auth-1
#   (leave AUTH_KEY_ID unset so the primary kid becomes the thumbprint)
# then drop both _PREVIOUS vars after ≥15 min. Don't rotate key material in that same deploy.
# AUTH_KEY_ID=
# AUTH_KEY_ID_PREVIOUS=
# AUTH_PUBLIC_KEY_PREVIOUS=
# AUTH_PUBLIC_KEY_PREVIOUS_FILE=/run/auth-keys/public-previous.pem

# TOTP / 2FA issuer label shown in authenticator apps
TOTP_ISSUER=Connected-Neighboors

# Email transport priority: SMTP (dev) → Resend (prod) → console fallback.
# In local dev, point SMTP at the mailpit sink (docker-compose.yml) to read
# verification/reset emails at http://localhost:8025 instead of sending for real.
# Leave SMTP_HOST unset and set RESEND_API_KEY to send via Resend.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# mailpit needs no auth; set SMTP_USER/SMTP_PASS only for a real SMTP server.
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
FROM_EMAIL=no-reply@example.com
APP_NAME=Connected-Neighboors

# Demo-data seed (npm run seed -w api) refuses to run when NODE_ENV=production;
# set this to true ONLY to force seeding a production database.
# SEED_ALLOW_PRODUCTION=true
# Password given to every demo user created by the seed script (default shown).
SEED_PASSWORD=Password123!
# Which scenario file under seed-data/ to load (without the .txt).
SEED_SCENARIO=demo

# Superadmin seed (npm run seed:superadmin -w auth-service). Defaults shown.
SEED_SUPERADMIN_EMAIL=superadmin@local.dev
SEED_SUPERADMIN_PASSWORD=ChangeMe!2345
SEED_SUPERADMIN_FIRSTNAME=Super
SEED_SUPERADMIN_LASTNAME=Admin

# ── Backups (scripts/backup.sh + restore.sh) ─────────────────────────────────
# Backup/restore reuse the Mongo/Neo4j/MinIO vars above; only these extra knobs
# are backup-specific (defaults shown). See scripts/README.md.
# BACKUP_DIR=./backups
# NEO4J_DATABASE=neo4j
# BACKUP_BUCKETS=messages listings documenso
# Set to 1 to run the tools inside the compose stack instead of on the host.
# USE_DOCKER=0
# COMPOSE_FILE=docker-compose.yml

# ── apps/admin-front (port 4000) ─────────────────────────────────────────────
# VITE_AUTH_SERVICE_URL=http://localhost:3001

# ── apps/user-front (port 5000) ──────────────────────────────────────────────
VITE_API_URL=http://localhost:3000
VITE_AUTH_SERVICE_URL=http://localhost:3001
# Public base URL of the user-front (shared @repo/config; auth-service also reads it
# server-side to redirect users after email verification / password reset)
VITE_APP_URL=http://localhost:5000
# Public base URL of the admin console (superAdmins are redirected here off the user-front)
VITE_ADMIN_URL=http://localhost:4000

# ── Debug / script toggles (apps/api) ────────────────────────────────────────
# Operational switch: set to "false" to disable the SATAN-QL repositories and fall
# back to plain Mongo repos (apps/api src/index.ts + repositories/container.ts).
# SATAN_REPOS=false
# Python interpreter the SATAN connector spawns (default "python3"); point at a
# python that can reach Mongo (repositories/satan.connector.ts).
# SATAN_PYTHON=python3
# Any truthy value logs the SATAN connector's stderr lines (repositories/satan.connector.ts).
# SATAN_DEBUG=1
# Used only by the endpoint-verification script (src/scripts/verify-endpoints.ts):
# AUTH_URL is the auth-service base it logs in against (default http://localhost:3001);
# OUT is a file path to write the JSON parity summary to.
# AUTH_URL=http://localhost:3001
# OUT=/tmp/satan-on.json
